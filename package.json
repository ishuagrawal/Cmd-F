{
  "name": "cmd-f",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:api": "node --import tsx apps/api/src/main.ts",
    "demo": "node --import tsx scripts/dev.ts --demo",
    "build": "node --import tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:eval": "node --import tsx tests/eval/run.ts",
    "test:live": "node --import tsx tests/eval/run.ts --live",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "pnpm build && node --import tsx scripts/package.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@phosphor-icons/react": "2.1.10",
    "cheerio": "1.1.2",
    "dotenv": "17.2.3",
    "fastify": "5.12.5",
    "ipaddr.js": "2.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "3.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.1.30",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.1",
    "esbuild": "0.27.0",
    "eslint": "10.0.1",
    "globals": "16.5.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
