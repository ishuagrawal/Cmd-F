# Copy to .env.local. Credentials stay on the backend.
TYPESAFE_API_KEY=
JEV_TRANSPORT=typesafe
# Direct TypeSafe model defaults to jev-1.13.0.
# Adding TYPESAFE_API_KEY selects direct live mode unless overridden below.
# Optional Gateway transport: JEV_TRANSPORT=gateway and AI_GATEWAY_API_KEY=...
# VERCEL_AI_GATEWAY_KEY is also accepted. Gateway defaults to typesafe-ai/jev.
# Leave JEV_MODEL unset when switching transports to use the appropriate default.
# PROVIDER_MODE=mock
API_PORT=4317
# Rebuild extension after changing the API port/origin.
CMD_F_API_BASE_URL=http://127.0.0.1:4317
# Optional; otherwise a random token is provisioned in .local/client-token
# and compiled into the unpacked extension at build/dev time.
CMD_F_CLIENT_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_PAGES=5
MAX_URLS=5000
SEARCH_DEADLINE_MS=30000
FETCH_TIMEOUT_MS=8000
LEASE_MS=45000
SESSION_TTL_MS=600000
CACHE_PATH=.local/public-cache.sqlite
CACHE_TTL_MS=900000
ENABLE_RENDERER=false
